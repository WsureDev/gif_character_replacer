# Fill .env locally. Never put credentials in documentation or commit .env.
# Base URL includes /v1; do not append /images/edits.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Set an image-edit model supported by your provider; aliases vary by provider.
OPENAI_IMAGE_MODEL=your-image-edit-model

# Quality and timeout are read by the CLI and server-provider configuration.
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=300000
# PNG, opaque background, n=1 and zero automatic retries are fixed by the code.
# Web concurrency is configured in the UI (default 2), not through this file.

# Web only: required to list/select server-managed providers; not a site login.
# Set a private value locally. An empty value disables access to the server list.
GIF_LAB_PROVIDER_SECRET=
# Entries may point to env prefixes, keeping keys out of this JSON.
# Omitted list defaults to [{"id":"default","envPrefix":"OPENAI"}].
GIF_LAB_PROVIDERS='[{"id":"default","envPrefix":"OPENAI"}]'
# Add a second entry {"id":"backup","envPrefix":"BACKUP"} and define:
# BACKUP_BASE_URL=https://backup.example.com/v1
# BACKUP_API_KEY=
# BACKUP_IMAGE_MODEL=provider-model-name
# BACKUP_IMAGE_QUALITY=medium
# BACKUP_IMAGE_TIMEOUT_MS=300000
# Inline entries also accept id, baseUrl, apiKey, model, quality, timeoutMs.
# Browser-custom configs are saved in localStorage, never in this file.

# Web runtime options are process environment variables. For example:
# export GIF_LAB_HOST=0.0.0.0
# export GIF_LAB_PORT=3087
# export GIF_LAB_DATA_DIR="$HOME/experiments/YYYY-MM-DD/gif-character-replacer-web"
